{
  "name": "pz-server-manager",
  "version": "1.0.7",
  "description": "Project Zomboid Server Manager - Web-based admin panel",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "build:exe": "node build.js",
    "build:exe:windows": "node build.js --windows",
    "build:exe:linux": "node build.js --linux",
    "build:exe:all": "node build.js --all",
    "start": "node server/index.js",
    "install:all": "npm install && cd client && npm install",
    "test": "vitest run --config vitest.config.js && cd client && npx vitest run",
    "test:watch": "vitest --config vitest.config.js",
    "test:server": "vitest run --config vitest.config.js",
    "test:client": "cd client && npx vitest run"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "lowdb": "^7.0.1",
    "node-cron": "^3.0.3",
    "rcon-srcds": "^2.0.1",
    "socket.io": "^4.8.1",
    "sql.js": "^1.14.1",
    "unzipper": "^0.12.3",
    "uuid": "^13.0.0",
    "winston": "^3.17.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "esbuild": "^0.27.1",
    "nodemon": "^3.1.7",
    "pkg": "^5.8.1",
    "vitest": "^4.1.0"
  }
}
