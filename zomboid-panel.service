[Unit]
Description=Zomboid Control Panel
After=network.target

[Service]
Type=simple
User=pzuser
Group=pzuser
WorkingDirectory=/opt/zomboid-panel
ExecStart=/opt/zomboid-panel/ZomboidControlPanel
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/zomboid-panel/data /opt/zomboid-panel/logs
PrivateTmp=true

[Install]
WantedBy=multi-user.target
